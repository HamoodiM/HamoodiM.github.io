import briefing from '../../assets/linguaspy/02_briefing_study_card.png';
import fade from '../../assets/linguaspy/05_occlusion_fade.png';
import intel from '../../assets/linguaspy/06_intel_check.png';
import blown from '../../assets/linguaspy/08_cover_blown.png';
import debrief from '../../assets/linguaspy/09_mission_grade_debrief.png';
import safehouse from '../../assets/linguaspy/11_safe_house.png';
import phrasebook from '../../assets/linguaspy/12_phrasebook.png';
import shipping from '../../assets/linguaspy/linguaspy-shipping-build-menu.jpg';

const poster = M.trailer.poster;
const p = await getImage({ src: poster, width: 1280, format: 'webp', quality: 74 });
const LS = 'https://github.com/HamoodiM/LinguaSpy/blob/d5e3353abf7e70f65aab1fbaf2e095598dd9972b/';

const grader = `
const TArray<FString>& Answer = Challenge.AcceptedAnswers[AnswerIndex].Tokens;

TArray<bool> Correct;
Correct.Init(false, Player.Num());
int32 Score = 0;
for (int32 i = 0; i < Player.Num(); ++i)
{
	if (Answer.IsValidIndex(i) && Player[i] == NormalizeToken(Answer[i]))
	{
		Correct[i] = true;
		++Score;
	}
}

const bool bExact = Score == Answer.Num() && Player.Num() == Answer.Num() && Answer.Num() > 0;
// Penalize length mismatch so the closest answer is also the closest in size
Score -= FMath::Abs(Answer.Num() - Player.Num());`;

const srs = `
FTimespan USrsScheduler::GetInterval(int32 Box)
{
	switch (FMath::Clamp(Box, 0, MaxBox))
	{
	case 0:
	case 1:  return FTimespan::FromMinutes(10.0);
	case 2:  return FTimespan::FromDays(1.0);
	case 3:  return FTimespan::FromDays(3.0);
	case 4:  return FTimespan::FromDays(7.0);
	default: return FTimespan::FromDays(21.0);
	}
}

void USrsScheduler::Update(FSrsItemState& State, bool bPassed, bool bAssisted, const FDateTime& Now)
{
	if (!bPassed)
	{
		++State.Failures;
		State.Box = 1;
	}
	else if (bAssisted)
	{
		++State.Passes;
		++State.AssistedPasses;
	}
	else
	{
		++State.Passes;
		State.Box = FMath::Min(State.Box + 1, MaxBox);
	}
	State.LastReviewUtcTicks = Now.GetTicks();
	State.DueUtcTicks = (Now + GetInterval(State.Box)).GetTicks();
}`;

const scaffold = `
EScaffoldLevel UScaffoldPolicy::ChooseLevel(const FSrsItemState* State, int32 SessionErrors, bool bTypingAllowed)
{
	int32 Level = static_cast<int32>(EScaffoldLevel::Assemble);
	const int32 Box = State ? State->Box : 0;
	if (Box >= 5)
	{
		Level = static_cast<int32>(EScaffoldLevel::Produce);
	}
	else if (Box >= 3)
	{
		Level = static_cast<int32>(EScaffoldLevel::GapFill);
	}
	else if (Box >= 1)
	{
		Level = static_cast<int32>(EScaffoldLevel::AssemblePlus);
	}

	if (!bTypingAllowed)
	{
		Level = FMath::Min(Level, static_cast<int32>(EScaffoldLevel::AssemblePlus));
	}
	Level = FMath::Max(Level - FMath::Max(SessionErrors, 0), static_cast<int32>(EScaffoldLevel::Recognize));
	return static_cast<EScaffoldLevel>(Level);
}`;

const saveH = `
/**
 *  Format version of this profile. Defaults to 0 on purpose: SaveGame serialization skips properties equal to the
 *  class default, so a default of CurrentVersion would never be written and old files would load as "current".
 *  Files written before v2 therefore load as 0 (= v1). Stamped with CurrentVersion on save / creation.
 */
UPROPERTY()
int32 Version = 0;`;

const saveCpp = `
void ULinguaSpySaveSubsystem::RequestSave()
{
	if (Save)
	{
		Save->Version = ULinguaSpySaveGame::CurrentVersion;
		UGameplayStatics::AsyncSaveGameToSlot(Save, SlotName, 0);
	}
}`;

const editor = `
const FScopedTransaction Transaction(LOCTEXT("AddNode", "Add Conversation Node"));
Current->Modify();
StampHandEdited(Current);`;

const shots = [
  { img: briefing, alt: 'Briefing for Operation First Contact: the handler introduces the mission and the first cover phrase, Bonjour, means hello or good morning, with Hear it and Next phrase buttons.', cap: 'Briefing: hear and read the cover phrases before the mission.' },
  { img: intel, alt: 'Marcel the kiosk vendor gives directions in French. The player picked the wrong English meaning, and the handler says to listen again.', cap: 'Intel check: act on what the local said. A wrong pick costs cover.' },
  { img: blown, alt: 'Tokyo: a wrong code reply to Yuki. The panel reads Cover blown, and the handler pulls the spy out to drill the phrases that gave them away.', cap: 'Cover blown: the mission stops and you drill the phrases you missed.' },
  { img: debrief, alt: 'Mission complete with grade A: 7 answers, 0 mistakes, 2 translations peeked. Below it a debrief question replays a phrase from the mission.', cap: 'Grade from mistakes and peeks, then a debrief with the handler.' },
  { img: safehouse, alt: 'Safe house panel for Paris: 7 phrases due for review, with progress bars for directions, ordering, politeness, preferences and small talk.', cap: 'Safe house: phrases come back on the Leitner schedule.' },
  { img: phrasebook, alt: 'Phrasebook for Paris: learned phrases filtered by skill, such as Où est la gare and Bonjour je voudrais un café.', cap: 'Phrasebook: everything learned so far, by skill.' },
  { img: fade, alt: 'Top-down street with a tree between the camera and the spy, drawn as a dither so the spy stays visible.', cap: 'Occlusion fade: whatever blocks the camera dithers out.' },
  { img: shipping, alt: 'The packaged Shipping build main menu with the participant code dialog for the field test.', cap: 'The packaged Shipping build, with participant code entry for the planned study.' },
];
---
<Base
  title="LinguaSpy, Mohammad Mohammad"
  description="LinguaSpy: a top-down language-learning spy game in Unreal Engine 5.8 C++. Sentence grader, Leitner scheduler, data-asset dialogue graphs, versioned saves, Slate editor tool."
  ogImage={poster}
  page="linguaspy"
