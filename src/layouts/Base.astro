---
import '../styles/global.css';
import Bar from '../components/Bar.astro';
import Footer from '../components/Footer.astro';
import frauncesUrl from '../fonts/fraunces-latin-opsz-normal.woff2?url';
import { getImage } from 'astro:assets';
import heroImg from '../assets/raytracer/hero_materials.png';
import { NAME, EMAIL, GITHUB, LINKEDIN } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: ImageMetadata;
  noindex?: boolean;
  jsonLd?: boolean;
  page?: string;
}
const { title, description, ogImage = heroImg, noindex = false, jsonLd = false, page = 'home' } = Astro.props;
const og = await getImage({ src: ogImage, width: 1200, format: 'jpeg', quality: 82 });
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogAbs = new URL(og.src, Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: NAME,
  email: `mailto:${EMAIL}`,
  jobTitle: 'Computer science student, gameplay and graphics programming',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Carleton University' },
  address: { '@type': 'PostalAddress', addressLocality: 'Ottawa', addressCountry: 'CA' },
  sameAs: [GITHUB, LINKEDIN],
  url: Astro.site?.toString(),
};
---
<!doctype html>
<html lang="en" data-motion="on" data-page={page}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#ebedf0" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#16191e" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogAbs} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} type="image/svg+xml" />
  <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
  <script is:inline>
    (function () {
      var d = document.documentElement, m;
      d.classList.add('js');
      try { m = localStorage.getItem('motion'); } catch (e) {}
      if (m !== 'on' && m !== 'off') m = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on';
      d.dataset.motion = m;
    })();
  </script>
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Bar page={page} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <script>
    import '../scripts/main';
  </script>
</body>
</html>
