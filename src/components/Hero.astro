---
import { Picture } from 'astro:assets';
import hero from '../assets/raytracer/hero_materials.png';
import { RESUME, GITHUB, LINKEDIN, EMAIL, TRACER_INSTALLED, url } from '../data/site';
---
<section class="hero" aria-labelledby="name">
  <div class="wrap hero__grid">
    <h1 id="name" class="hero__name"><span>Mohammad</span> <span>Mohammad</span></h1>

    <div class="hero__text">
      <p class="hero__role">Gameplay and graphics programming in C++ and Unreal Engine&nbsp;5.</p>
      <p>I study computer science at Carleton University in Ottawa and graduate in April 2028. I'm looking for a Summer 2027 internship in gameplay programming or software engineering.</p>
      <ul class="hero__links">
        <li><a href={RESUME}>Résumé (PDF)</a></li>
        <li><a href={GITHUB}>GitHub</a></li>
        <li><a href={LINKEDIN}>LinkedIn</a></li>
        <li><a href={`mailto:${EMAIL}`}>mohammadmohammad3@<wbr />cmail.carleton.ca</a></li>
      </ul>
    </div>

    <figure class="hero__render" data-island={TRACER_INSTALLED ? 'hero' : undefined} data-island-when="idle">
      <div class="viewport">
        <Picture
          src={hero}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          quality={72}
          widths={[480, 720, 960]}
          sizes="(min-width: 60rem) 62vw, 100vw"
          alt="Five spheres on a checkerboard floor: matte red, normal-mapped brick, clear glass, gold and chrome, with two small glowing spheres in front. Rendered by my path tracer."
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="viewport__img"
        />
        {TRACER_INSTALLED && <canvas class="viewport__canvas" hidden aria-hidden="true"></canvas>}
      </div>
      <figcaption class="hud">
        <p class="hud__state" data-hud-state>
          <span class="hud__k">Static render</span>
          <span class="hud__v"><code>hero_materials.json</code>, 960×540, 1024 samples per pixel, from the WebAssembly build of my <a href={url('projects/raytracer/')}>path tracer</a>.</span>
        </p>
        {TRACER_INSTALLED && (
          <div class="hud__controls" data-hud-controls>
            <button class="btn" type="button" data-live-start>Render it live on this device</button>
            <button class="btn" type="button" data-live-pause hidden>Pause</button>
            <button class="btn" type="button" data-live-bvh aria-pressed="true" hidden>BVH on</button>
            <button class="btn" type="button" data-live-reset hidden>Reset</button>
            <p class="hud__readout" data-hud-readout aria-live="polite" hidden></p>
            <p class="hud__hint small muted" data-hud-hint hidden>Drag the image to orbit. Every move throws away the samples and starts again from noise.</p>
          </div>
        )}
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 7vw, 5rem); }
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2rem);
    row-gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
  }
  .hero__name { grid-column: 1 / -1; }
  .hero__name span { display: inline-block; }
  .hero__text { grid-column: 1 / span 4; display: grid; gap: 1rem; max-width: 30rem; }
  .hero__role { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.2; font-weight: 400; letter-spacing: -0.01em; }
  .hero__links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-top: 0.25rem; }
  .hero__links a { overflow-wrap: anywhere; }
  .hero__render { grid-column: 5 / -1; }

  .viewport { position: relative; aspect-ratio: 16 / 9; background: #2c313b; overflow: hidden; }
  .viewport :global(.viewport__img), .viewport :global(picture) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .viewport :global(.viewport__img) { object-fit: cover; }
  .viewport__canvas { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; cursor: grab; touch-action: pan-y; }
  .viewport__canvas:active { cursor: grabbing; }

  .hud { margin-top: 0.75rem; font-size: var(--step--1); color: var(--ink-2); display: grid; gap: 0.75rem; }
  .hud__state { display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
  .hud__k { color: var(--ink); font-weight: 600; }
  .hud__controls { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .hud__readout { font-family: var(--font-mono); font-variant-numeric: tabular-nums; color: var(--ink); width: 100%; }

  @media (max-width: 60rem) {
    .hero__text { grid-column: 1 / -1; max-width: var(--measure); }
    .hero__render { grid-column: 1 / -1; }
  }
  @media (max-width: 40rem) {
    .hero { padding-block: 1rem 2rem; }
    .hero__grid { row-gap: 1rem; }
    .hero__render { margin-inline: calc(-1 * var(--gutter)); }
    .hud { padding-inline: var(--gutter); font-size: 0.8rem; }
    .hero__name { font-size: clamp(2.6rem, 13vw, 4.5rem); }
    .hero__role { font-size: 1.3rem; }
    .hero__text { gap: 0.6rem; }
    .hero__text p:not(.hero__role) { font-size: 0.98rem; line-height: 1.5; }
  }
</style>
