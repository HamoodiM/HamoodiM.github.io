---
import LoopVideo from './LoopVideo.astro';
import { linguaspyMedia } from '../data/media';
import { RESUME, GITHUB, LINKEDIN, EMAIL, url } from '../data/site';
---
<section class="hero" aria-labelledby="name">
  <div class="wrap hero__grid">
    <h1 id="name" class="hero__name"><span>Mohammad</span> <span>Mohammad</span></h1>

    <div class="hero__text">
      <p class="hero__role">Gameplay programming in C++ and Unreal Engine&nbsp;5.</p>
      <p>I study computer science at Carleton University in Ottawa and graduate in May 2028. I'm looking for a Summer 2027 internship in gameplay programming or software engineering.</p>
      <ul class="hero__links">
        <li><a href={RESUME}>Résumé (PDF)</a></li>
        <li><a href={GITHUB}>GitHub</a></li>
        <li><a href={LINKEDIN}>LinkedIn</a></li>
        <li><a href={`mailto:${EMAIL}`}>mohpresentations@<wbr />gmail.com</a></li>
      </ul>
    </div>

    <div class="hero__render">
      <LoopVideo
        src={linguaspyMedia.loop.src}
        poster={linguaspyMedia.loop.poster}
        label="Twelve-second loop from LinguaSpy: the spy builds a French reply from word tiles, gets it wrong, the handler gives a hint, and the second try passes."
        caption="LinguaSpy, my Unreal Engine 5 C++ spy game: answer the locals in their language or lose your cover."
      />
      <p class="hero__more"><a href={url('projects/linguaspy/')}>Watch the 80-second trailer and read how it works</a></p>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 7vw, 5rem); }
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.5vw, 2rem);
    row-gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
  }
  .hero__name { grid-column: 1 / -1; }
  .hero__name span { display: inline-block; }
  .hero__text { grid-column: 1 / span 4; display: grid; gap: 1rem; max-width: 30rem; }
  .hero__role { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.2; font-weight: 400; letter-spacing: -0.01em; }
  .hero__links { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; margin-top: 0.25rem; }
  .hero__links a { overflow-wrap: anywhere; }
  .hero__render { grid-column: 5 / -1; }

  .hero__more { margin-top: 0.6rem; font-size: var(--step--1); }
  @media (max-width: 60rem) {
    .hero__text { grid-column: 1 / -1; max-width: var(--measure); }
    .hero__render { grid-column: 1 / -1; }
  }
  @media (max-width: 40rem) {
    .hero { padding-block: 1rem 2rem; }
    .hero__grid { row-gap: 1rem; }
    .hero__name { font-size: clamp(2.6rem, 13vw, 4.5rem); }
    .hero__role { font-size: 1.3rem; }
    .hero__text { gap: 0.6rem; }
    .hero__text p:not(.hero__role) { font-size: 0.98rem; line-height: 1.5; }
  }
</style>
