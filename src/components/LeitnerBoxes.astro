---
// Interactive version of USrsScheduler::Update and UScaffoldPolicy::ChooseLevel (box -> exercise),
// ported line for line to TypeScript in src/scripts/islands/leitner.ts.
const boxes = [
  { box: 0, wait: '10 min', ex: 'Word tiles' },
  { box: 1, wait: '10 min', ex: 'Tiles plus distractors' },
  { box: 2, wait: '1 day', ex: 'Tiles plus distractors' },
  { box: 3, wait: '3 days', ex: 'Type the missing word' },
  { box: 4, wait: '7 days', ex: 'Type the missing word' },
  { box: 5, wait: '21 days', ex: 'Type the whole sentence' },
];
---
<div class="lt" data-island="leitner">
  <p class="lt__phrase">
    <span class="lt__q" lang="fr">Bonjour, je voudrais un café, s'il vous plaît.</span>
    <span class="small">A phrase from the Paris café conversation, tracked as one review item.</span>
  </p>
  <ol class="lt__boxes" start="0">
    {boxes.map((b) => (
      <li class="lt__box" data-box={b.box}>
        <span class="lt__n">Box {b.box}</span>
        <span class="lt__wait">due in {b.wait}</span>
        <span class="lt__ex">{b.ex}</span>
        <span class="lt__slot" data-slot={b.box}>
          {b.box === 0 && <span class="lt__card" data-card aria-hidden="true">café</span>}
        </span>
      </li>
    ))}
  </ol>
  <div class="lt__actions" hidden data-lt-actions>
    <button class="btn" type="button" data-lt="pass">Answer correctly</button>
    <button class="btn" type="button" data-lt="assisted">Answer after peeking</button>
    <button class="btn" type="button" data-lt="fail">Get it wrong</button>
    <button class="btn lt__reset" type="button" data-lt="reset">Start over</button>
  </div>
  <p class="lt__log" aria-live="polite" data-lt-log>New phrases start in box 0. A correct answer without help moves the phrase up one box; a correct answer after peeking at the translation keeps it where it is; a wrong answer sends it back to box 1, due again in ten minutes.</p>
  <pre class="lt__code" aria-label="The Update function the buttons run"><code>void USrsScheduler::Update(FSrsItemState&amp; State, bool bPassed, bool bAssisted, const FDateTime&amp; Now)
&#123;
	<span data-line="fail">if (!bPassed) &#123; ++State.Failures; State.Box = 1; &#125;</span>
	<span data-line="assisted">else if (bAssisted) &#123; ++State.Passes; ++State.AssistedPasses; &#125;</span>
	<span data-line="pass">else &#123; ++State.Passes; State.Box = FMath::Min(State.Box + 1, MaxBox); &#125;</span>
	State.DueUtcTicks = (Now + GetInterval(State.Box)).GetTicks();
&#125;</code></pre>
  <p class="small lt__note">Condensed from <code>Source/Personal/LinguaSpy/Language/SrsScheduler.cpp</code>, lines 46–65. Each wrong attempt earlier in the same session also drops the exercise one level, and Japanese stays on tiles because it has no spaces between words.</p>
</div>

<style>
  .lt { display: grid; gap: 1rem; }
  .lt__phrase { display: grid; gap: 0.2rem; }
  .lt__q { font-family: var(--dossier-type); font-size: var(--step-1); }
  .lt__boxes { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.4rem; counter-reset: none; }
  .lt__box {
    display: grid; grid-template-rows: auto auto auto 1fr; gap: 0.15rem;
    padding: 0.55rem 0.55rem 0.6rem;
    border: 1px solid var(--d-rule);
    background: var(--d-card);
    font-size: 0.8rem; line-height: 1.3;
    min-height: 9.5rem;
  }
  .lt__n { font-family: var(--dossier-type); font-weight: 700; font-size: 0.95rem; }
  .lt__wait { color: var(--d-ink-2); }
  .lt__ex { color: var(--d-ink-2); }
  .lt__slot { display: flex; align-items: flex-end; min-height: 2.2rem; }
  .lt__card {
    display: inline-block; padding: 0.3rem 0.55rem;
    background: var(--d-stamp); color: #fff8ec;
    font-family: var(--dossier-type); font-weight: 700; font-size: 0.85rem;
    transform: rotate(-2deg);
  }
  .lt__box[data-current] { border-color: var(--d-stamp); box-shadow: inset 0 0 0 1px var(--d-stamp); }
  .lt__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .lt__actions .btn { color: var(--d-ink); }
  .lt__actions .btn:hover { background: var(--d-ink); color: var(--d-paper); }
  .lt__reset { margin-left: auto; }
  .lt__log { min-height: 3em; max-width: 44rem; }
  .lt__code { background: #1d1b17; color: #eae2cf; padding: 0.9rem 1rem; overflow-x: auto; font-size: 0.78rem; line-height: 1.55; border-radius: 2px; }
  .lt__code [data-line] { display: inline-block; padding-inline: 0.2rem; margin-inline: -0.2rem; transition: background-color 300ms var(--ease), color 300ms var(--ease); }
  .lt__code [data-line][data-hit] { background: #ffd9a0; color: #1d1b17; }
  .lt__note { color: var(--d-ink-2); }
  @media (max-width: 46rem) {
    .lt__boxes { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lt__box { min-height: 8rem; }
    .lt__reset { margin-left: 0; }
  }
</style>
