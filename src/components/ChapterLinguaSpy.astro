---
import { Image } from 'astro:assets';
import '../styles/ls-demo.css';
import LoopVideo from './LoopVideo.astro';
import paris from '../assets/linguaspy/03_paris_grader_hint.png';
import madrid from '../assets/linguaspy/10_madrid.png';
import tokyo from '../assets/linguaspy/07_tokyo_romaji_tiles.png';
import menu from '../assets/linguaspy/01_main_menu.png';
import { linguaspyMedia } from '../data/media';
import { url, LINGUASPY_DEMO_INSTALLED } from '../data/site';

const cities = [
  {
    id: 'paris', name: 'Paris', lang: 'French', img: paris,
    alt: 'Paris: the spy at a café counter. The barista asks what she can get you, and the reply is being built from French word tiles while the handler says to start with a greeting.',
    facts: ['9 conversations, 2 missions, 2 assessment forms', 'Voiced offline with Piper TTS', 'Operation First Contact: order a coffee from Camille at the café'],
  },
  {
    id: 'madrid', name: 'Madrid', lang: 'Spanish', img: madrid,
    alt: 'Madrid: the spy at a tapas bar. The waiter asks if you want something to drink, and the tiles Un agua por favor are all marked correct.',
    facts: ['9 conversations, 2 missions', 'Text only for now; Spanish voices are on the list', 'La Tapa Secreta at the tapas bar; El Palacio is the A2-level mission'],
  },
  {
    id: 'tokyo', name: 'Tokyo', lang: 'Japanese', img: tokyo,
    alt: 'Tokyo: the spy at a konbini. Japanese tiles kudasai, o, onigiri carry romaji readings, and the wrong tiles are highlighted.',
    facts: ['3 conversations, 1 mission', 'Konbini Contact: buy an onigiri from Sato-san', 'Unspaced chunk tiles with optional romaji readings; text only because of the voice licence'],
  },
  // TODO-USER: Rome shows the main-menu card because there is no in-game Rome capture yet. Capture one
  // (an Italian conversation), add it to src/assets/linguaspy/, import it and use it here.
  {
    id: 'rome', name: 'Rome', lang: 'Italian', img: menu,
    alt: 'The LinguaSpy main menu: four city cards for Paris, Madrid, Tokyo and Rome, each with its language and mission count.',
    facts: ['3 conversations, 1 mission', 'Text only for now', 'Operazione Colosseo is still to be built', 'No in-game capture of Rome yet, so this is its card on the main menu'],
  },
];
---
<section class="ch-ls" id="linguaspy" aria-labelledby="ls-h">
  <div class="wrap">
    <div class="folder">
      <p class="folder__tab" aria-hidden="true">Case file: LinguaSpy</p>
      <div class="folder__body">
        <header class="folder__head">
          <h2 id="ls-h" data-reveal>LinguaSpy</h2>
          <p class="stamps" aria-label="Status">
            <span class="stamp" data-stamp>Solo project</span>
            <span class="stamp stamp--b" data-stamp>Prototype v0.5</span>
          </p>
        </header>

        <div class="brief">
          <div class="brief__text" data-redact>
            <p>A top-down spy game about learning a language, in Unreal Engine 5.8 and C++. You're undercover in Paris, Madrid, Tokyo or Rome and keep your cover by answering locals in French, Spanish, Japanese or Italian. Wrong answers drain the cover meter. Blow it and you're sent back to drill the phrases you missed.</p>
            <p>What's in the C++: a sentence grader that marks each word and spots accent-only mistakes, a Leitner spaced-repetition scheduler, a policy that picks the exercise type from how well you know a phrase, branching dialogue and mission graphs stored as data assets, a versioned save format with migrations, and a Slate editor tab for authoring conversations. 19 automation tests cover the pure logic.</p>
          </div>
          <dl class="brief__facts">
            <dt>Engine</dt><dd>Unreal Engine 5.8</dd>
            <dt>C++</dt><dd>About 14,000 lines in the game and editor modules, 776 of them tests</dd>
            <dt>Python</dt><dd>About 4,000 lines of editor tooling</dd>
            <dt>Built</dt><dd>Sept 29 to Oct 4, 2026, 26 commits</dd>
            <dt>Build</dt><dd>A Windows Shipping build packages</dd>
          </dl>
        </div>

        <LoopVideo
          src={linguaspyMedia.loop.src}
          poster={linguaspyMedia.loop.poster}
          label="Twelve-second loop: the spy builds a French reply from word tiles, gets it wrong, the handler gives a hint, and the second try passes."
          caption="Twelve seconds from the Paris café: wrong tiles, a targeted hint from the grader, then an assisted pass. The full 80-second trailer is on the write-up page."
        />

        <div class="cities" data-island="dossier">
          <h3 class="cities__h">Four cities, one set of systems</h3>
          <div class="cities__tabs" role="tablist" aria-label="Cities" hidden data-tablist>
            {cities.map((c, i) => (
              <button class="cities__tab" role="tab" type="button" id={`city-tab-${c.id}`} aria-controls={`city-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-city={c.id}>
                {c.name}
              </button>
            ))}
            <span class="cities__marker" aria-hidden="true" data-marker></span>
          </div>
          {cities.map((c, i) => (
            <section class="city" id={`city-${c.id}`} role="tabpanel" aria-labelledby={`city-tab-${c.id}`} data-panel data-active={i === 0 ? '' : undefined}>
              <h4 class="city__name">{c.name} <span class="muted">in {c.lang}</span></h4>
              <div class="city__grid">
                {c.img ? (
                  <Image src={c.img} alt={c.alt} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 38rem, 100vw" loading="lazy" decoding="async" class="city__img" />
                ) : (
                  <div class="city__noimg">
                    <p>No capture of Rome yet.</p>
                    {/* TODO-USER: capture a Rome screenshot (a conversation in Italian) and add it to src/assets/linguaspy/, then set img for 'rome' in ChapterLinguaSpy.astro. */}
                  </div>
                )}
                <ul class="city__facts">
                  {c.facts.map((f) => <li>{f}</li>)}
                </ul>
              </div>
            </section>
          ))}
        </div>

        {LINGUASPY_DEMO_INSTALLED && (
          <div class="demo" data-island="lsdemo">
            <h3>Answer a local</h3>
            <p class="demo__label">TypeScript port of the game's C++ grader and scheduler, tested against the same cases. The game itself is C++; this runs in your browser so you can try the rules without installing anything.</p>
            <p class="small demo__tips">No French needed: leave out a word, or drop an accent, and watch what the grader says. The six boxes underneath are the Leitner scheduler; the clock buttons skip ahead so phrases come due.</p>
            <div class="demo__root" data-demo-root></div>
            <noscript><p>The demo needs JavaScript. The rules it runs are described on the <a href={url('projects/linguaspy/')}>write-up page</a>.</p></noscript>
          </div>
        )}

        <p class="folder__links">
          <a href={url('projects/linguaspy/')}>Read the full write-up: grader, scheduler, save format, editor tool</a>
          <a href={url('projects/linguaspy/#trailer')}>Watch the trailer</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .ch-ls {
    overflow-x: clip;
    --d-paper: #e9dcc0;
    --d-card: #f2e8d2;
    --d-ink: #1f1c17;
    --d-ink-2: #5a5040;
    --d-rule: #c4b28d;
    --d-stamp: #b8322a;
    --dossier-type: 'Courier New', Courier, 'Nimbus Mono PS', monospace;
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  @media (prefers-color-scheme: dark) {
    .ch-ls { --d-paper: #d9cba9; --d-card: #e4d7b9; }
  }
  .folder { position: relative; color: var(--d-ink); }
  .folder__tab {
    display: inline-block;
    background: var(--d-paper);
    padding: 0.55rem 1.25rem 0.4rem;
    font-family: var(--dossier-type);
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 6px 6px 0 0;
    clip-path: polygon(0 100%, 0 0, calc(100% - 1.2rem) 0, 100% 100%);
    padding-right: 2.4rem;
  }
  .folder__body {
    background: var(--d-paper);
    padding: clamp(1.25rem, 4vw, 3.5rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08), 0 18px 40px -28px rgba(40, 28, 10, 0.45);
  }
  .folder a { color: var(--d-ink); }
  .folder :global(:not(pre) > code) { background: rgba(80, 60, 20, 0.1); }
  .folder :focus-visible { outline-color: var(--d-stamp); }
  .folder__head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem 2rem; }
  .folder__head h2 { color: var(--d-ink); }

  .stamps { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .stamp {
    display: inline-block;
    font-family: var(--dossier-type);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    color: var(--d-stamp);
    border: 3px double var(--d-stamp);
    padding: 0.25rem 0.6rem;
    transform: rotate(-5deg);
    mix-blend-mode: multiply;
    opacity: 0.88;
  }
  .stamp--b { transform: rotate(3deg); }

  .brief { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); }
  .brief__text { font-family: var(--dossier-type); font-size: 1.02rem; line-height: 1.6; max-width: 40rem; }
  .brief__text :global(.redact-line) { position: relative; }
  .brief__text :global(.redact-bar) { position: absolute; left: -0.1em; right: -0.1em; top: 0.12em; bottom: 0.08em; background: var(--d-ink); transform-origin: 100% 50%; pointer-events: none; }
  .brief__facts { display: grid; grid-template-columns: max-content 1fr; gap: 0.5rem 1rem; align-content: start; font-size: 0.95rem; border-top: 2px solid var(--d-ink); padding-top: 0.9rem; }
  .brief__facts dt { font-family: var(--dossier-type); font-weight: 700; }
  .brief__facts dd { margin: 0; }

  .cities { display: grid; gap: 1rem; }
  .cities__h { color: var(--d-ink); }
  .cities__tabs { position: relative; display: flex; gap: 0.25rem; flex-wrap: wrap; border-bottom: 2px solid var(--d-ink); }
  .cities__tab {
    position: relative; z-index: 0; isolation: isolate;
    font-family: var(--dossier-type); font-weight: 700; font-size: 1rem;
    background: none; border: 0; color: var(--d-ink-2);
    padding: 0.55rem 1rem 0.5rem; cursor: pointer;
  }
  .cities__tab[aria-selected='true'] { color: #fff8ec; }
  .cities__marker { position: absolute; z-index: -1; inset: 0; background: var(--d-ink); pointer-events: none; }
  .cities__tabs > .cities__marker { display: none; }
  .city { display: grid; gap: 0.75rem; }
  .city + .city { margin-top: 1.5rem; }
  .city__name { font-family: var(--font-display); font-size: var(--step-2); font-weight: 400; }
  :global(html.js) .cities__tabs ~ .city .city__name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  :global(html.js) .city:not([data-active]) { display: none; }
  :global(html.js) .city + .city { margin-top: 0; }
  .city__grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 1.5rem; align-items: start; }
  .city__grid :global(.city__img) { width: 100%; height: auto; border: 6px solid #fbf6ea; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2); transform: rotate(-0.4deg); }
  .city__noimg { aspect-ratio: 16 / 9; display: grid; place-items: center; border: 2px dashed var(--d-rule); font-family: var(--dossier-type); color: var(--d-ink-2); }
  .city__facts { padding-left: 1.1rem; display: grid; gap: 0.5rem; }

  .demo { display: grid; gap: 0.75rem; border-top: 2px solid var(--d-ink); padding-top: 1.5rem; }
  .demo__label { font-family: var(--dossier-type); font-weight: 700; max-width: 46rem; }
  .demo__tips { color: var(--d-ink-2); max-width: 46rem; }
  .demo__root { min-height: 30rem; }

  .folder__links { display: flex; flex-wrap: wrap; gap: 0.75rem 2rem; font-weight: 600; }

  @media (max-width: 52rem) {
    .brief, .city__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 40rem) {
    .folder__body { margin-inline: calc(-1 * var(--gutter) + 0.5rem); }
    .stamp { font-size: 0.72rem; }
    .brief__text { font-size: 0.95rem; }
  }
</style>
